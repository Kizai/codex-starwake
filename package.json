{
  "name": "codex-starwake",
  "version": "0.1.0",
  "private": true,
  "description": "Cinematic startup animations for Codex on macOS",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write web tests package.json .prettierrc.json .github/workflows/ci.yml",
